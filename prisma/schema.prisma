generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id             String          @id @default(uuid()) @db.Uuid
  name           String
  industryType   String          @map("industry_type")
  employeeLimit  Int             @map("employee_limit")
  timezone       String          @default("UTC")
  status         String          @default("active")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @default(now()) @map("updated_at")
  auditLogs      AuditLog[]
  departments    Department[]
  employees      Employee[]
  holidays       Holiday[]
  leaveTypes     LeaveType[]
  payrollCycles  PayrollCycle[]
  roles          Role[]
  shifts         Shift[]
  subscriptions  Subscription[]
  systemSettings SystemSetting[]
  teams          Team[]
  users          User[]
  workLocations  WorkLocation[]
  workflows      Workflow[]
  clusters       Cluster[]
  payrollRules   PayrollRule[]
  payrollRuns    PayrollRun[]
  compensationCycles CompensationCycle[]
  salaryComponents SalaryComponent[]
  salaryTemplates  SalaryTemplate[]

  @@map("companies")
}

model User {
  id              String             @id @default(uuid()) @db.Uuid
  companyId       String             @map("company_id") @db.Uuid
  email           String
  passwordHash    String             @map("password_hash")
  roleId          String             @map("role_id") @db.Uuid
  workLocationId  String?            @map("work_location_id") @db.Uuid
  clusterId       String?            @map("cluster_id") @db.Uuid
  fcmToken        String?            @map("fcm_token")
  isActive        Boolean            @default(true) @map("is_active")
  lastLoginAt     DateTime?          @map("last_login_at")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  actedLogs       ApprovalLog[]
  auditLogs       AuditLog[]
  uploadedDocs    EmployeeDocument[]
  employee        Employee?
  triggeredCycles PayrollCycle[]
  triggeredRuns   PayrollRun[]
  company         Company            @relation(fields: [companyId], references: [id])
  role            Role               @relation(fields: [roleId], references: [id])
  workLocation    WorkLocation?      @relation(fields: [workLocationId], references: [id])
  cluster         Cluster?           @relation(fields: [clusterId], references: [id])

  @@unique([companyId, email])
  @@map("users")
}

model Role {
  id            String           @id @default(uuid()) @db.Uuid
  companyId     String?          @map("company_id") @db.Uuid
  name          String
  description   String?
  isSystemRole  Boolean          @default(true) @map("is_system_role")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  approvalSteps ApprovalStep[]
  permissions   RolePermission[]
  company       Company?         @relation(fields: [companyId], references: [id])
  users         User[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique
  description String?
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id])
  role         Role       @relation(fields: [roleId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Department {
  id             String        @id @default(uuid()) @db.Uuid
  companyId      String        @map("company_id") @db.Uuid
  workLocationId String?       @map("work_location_id") @db.Uuid
  name           String
  managerId      String?       @map("manager_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  company        Company       @relation(fields: [companyId], references: [id])
  workLocation   WorkLocation? @relation(fields: [workLocationId], references: [id])
  manager        Employee?     @relation("DepartmentManager", fields: [managerId], references: [id])
  employees      Employee[]    @relation("EmployeeDepartment")
  teams          Team[]

  @@map("departments")
}

model Team {
  id             String        @id @default(uuid()) @db.Uuid
  companyId      String        @map("company_id") @db.Uuid
  departmentId   String        @map("department_id") @db.Uuid
  workLocationId String?       @map("work_location_id") @db.Uuid
  name           String
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  employees      Employee[]
  company        Company       @relation(fields: [companyId], references: [id])
  department     Department    @relation(fields: [departmentId], references: [id])
  workLocation   WorkLocation? @relation(fields: [workLocationId], references: [id])

  @@map("teams")
}

model Cluster {
  id             String         @id @default(uuid()) @db.Uuid
  companyId      String         @map("company_id") @db.Uuid
  name           String
  code           String?
  state          String?
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @default(now()) @map("updated_at")
  company        Company        @relation(fields: [companyId], references: [id])
  workLocations  WorkLocation[]
  holidays       Holiday[]
  users          User[]

  @@unique([companyId, name])
  @@map("clusters")
}

model WorkLocation {
  id             String          @id @default(uuid()) @db.Uuid
  companyId      String          @map("company_id") @db.Uuid
  clusterId      String?         @map("cluster_id") @db.Uuid
  name           String
  address        String?
  geoRequired    Boolean         @default(false) @map("geo_required")
  latitude       Decimal?
  longitude      Decimal?
  radiusMeters   Int?            @map("radius_meters")
  createdAt      DateTime        @default(now()) @map("created_at")
  attendanceLogs AttendanceLog[]
  employees      Employee[]
  holidays       Holiday[]
  payrollCycles  PayrollCycle[]
  payrollRules   PayrollRule[]
  shifts         Shift[]
  users          User[]
  departments    Department[]
  teams          Team[]
  company        Company         @relation(fields: [companyId], references: [id])
  cluster        Cluster?        @relation(fields: [clusterId], references: [id])

  @@map("work_locations")
}

model Shift {
  id             String          @id @default(uuid()) @db.Uuid
  companyId      String          @map("company_id") @db.Uuid
  workLocationId String?         @map("work_location_id") @db.Uuid
  name           String
  code           String          @map("code") @default("SHIFT")
  startTime      DateTime        @map("start_time") @db.Time(6)
  endTime        DateTime        @map("end_time") @db.Time(6)
  graceMinutes   Int             @default(0) @map("grace_minutes")
  breakDuration  Int             @default(0) @map("break_duration")
  status         String          @default("active")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  attendanceLogs AttendanceLog[]
  employeeShifts EmployeeShift[]
  company        Company         @relation(fields: [companyId], references: [id])
  workLocation   WorkLocation?   @relation(fields: [workLocationId], references: [id])

  @@unique([companyId, code])
  @@map("shifts")
}

model EmployeeShift {
  id            String    @id @default(uuid()) @db.Uuid
  employeeId    String    @map("employee_id") @db.Uuid
  shiftId       String    @map("shift_id") @db.Uuid
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  employee      Employee  @relation(fields: [employeeId], references: [id])
  shift         Shift     @relation(fields: [shiftId], references: [id])

  @@unique([employeeId, effectiveFrom])
  @@index([shiftId])
  @@index([employeeId])
  @@map("employee_shifts")
}

model Employee {
  id                String                   @id @default(uuid()) @db.Uuid
  companyId         String                   @map("company_id") @db.Uuid
  userId            String                   @unique @map("user_id") @db.Uuid
  employeeCode      String                   @map("employee_code")
  departmentId      String                   @map("department_id") @db.Uuid
  workLocationId    String                   @map("work_location_id") @db.Uuid
  teamId            String?                  @map("team_id") @db.Uuid
  managerId         String?                  @map("manager_id") @db.Uuid
  dateOfJoining     DateTime                 @map("date_of_joining") @db.Date
  employmentStatus  String                   @default("active") @map("employment_status")
  dateOfLeaving     DateTime?                @map("date_of_leaving") @db.Date
  onboardingStep    Int                      @default(1) @map("onboarding_step")
  profileCompletion Int                      @default(0) @map("profile_completion")
  salaryTemplateId  String?                  @map("salary_template_id") @db.Uuid
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")
  attendanceLogs    AttendanceLog[]
  attendanceReqs    AttendanceRequest[]
  managedDepts      Department[]             @relation("DepartmentManager")
  bankDetails       EmployeeBankDetail?
  documents         EmployeeDocument[]
  jobDetails        EmployeeJobDetail?
  personalDetails   EmployeePersonalDetail?
  shifts            EmployeeShift[]
  statutoryDetails  EmployeeStatutoryDetail?
  company           Company                  @relation(fields: [companyId], references: [id])
  department        Department               @relation("EmployeeDepartment", fields: [departmentId], references: [id])
  manager           Employee?                @relation("EmployeeManager", fields: [managerId], references: [id])
  subordinates      Employee[]               @relation("EmployeeManager")
  team              Team?                    @relation(fields: [teamId], references: [id])
  user              User                     @relation(fields: [userId], references: [id])
  workLocation      WorkLocation             @relation(fields: [workLocationId], references: [id])
  salaryTemplate    SalaryTemplate?          @relation(fields: [salaryTemplateId], references: [id])
  leaveBalances     LeaveBalance[]
  leaveRequests     LeaveRequest[]
  overtimeRecords   OvertimeRecord[]
  payrollRecords    PayrollRecord[]
  salaryStructures  SalaryStructure[]
  salaryRevisions   SalaryRevision[]

  @@unique([companyId, employeeCode])
  @@map("employees")
}

model EmployeePersonalDetail {
  id             String    @id @default(uuid()) @db.Uuid
  employeeId     String    @unique @map("employee_id") @db.Uuid
  firstName      String    @map("first_name")
  lastName       String    @map("last_name")
  mobile         String?
  gender         String?
  dob            DateTime? @db.Date
  maritalStatus  String?   @map("marital_status")
  currentAddress String?   @map("current_address")
  permAddress    String?   @map("perm_address")
  employee       Employee  @relation(fields: [employeeId], references: [id])

  @@map("employee_personal_details")
}

model EmployeeJobDetail {
  id               String    @id @default(uuid()) @db.Uuid
  employeeId       String    @unique @map("employee_id") @db.Uuid
  designation      String?
  employmentType   String?   @map("employment_type")
  workLocationType String?   @map("work_location_type")
  probationPeriod  Int?      @map("probation_period")
  confirmationDate DateTime? @map("confirmation_date") @db.Date
  noticePeriod     Int?      @map("notice_period")
  employee         Employee  @relation(fields: [employeeId], references: [id])

  @@map("employee_job_details")
}

model EmployeeBankDetail {
  id            String   @id @default(uuid()) @db.Uuid
  employeeId    String   @unique @map("employee_id") @db.Uuid
  accountNumber String?  @map("account_number")
  ifscCode      String?  @map("ifsc_code")
  bankName      String?  @map("bank_name")
  branchName    String?  @map("branch_name")
  employee      Employee @relation(fields: [employeeId], references: [id])

  @@map("employee_bank_details")
}

model EmployeeStatutoryDetail {
  id            String   @id @default(uuid()) @db.Uuid
  employeeId    String   @unique @map("employee_id") @db.Uuid
  pan           String?  @unique
  uan           String?  @unique
  pfApplicable  Boolean  @default(false) @map("pf_applicable")
  esiNumber     String?  @unique @map("esi_number")
  esiApplicable Boolean  @default(false) @map("esi_applicable")
  ptState       String?  @map("pt_state")
  taxRegime     String?  @default("new") @map("tax_regime")
  employee      Employee @relation(fields: [employeeId], references: [id])

  @@map("employee_statutory_details")
}

model EmployeeDocument {
  id           String    @id @default(uuid()) @db.Uuid
  employeeId   String    @map("employee_id") @db.Uuid
  documentType String    @map("document_type")
  fileUrl      String    @map("file_url")
  fileName     String?   @map("file_name")
  expiryDate   DateTime? @map("expiry_date") @db.Date
  uploadedBy   String    @map("uploaded_by") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")
  employee     Employee  @relation(fields: [employeeId], references: [id])
  uploader     User      @relation(fields: [uploadedBy], references: [id])

  @@map("employee_documents")
}

model SalaryStructure {
  id            String                @id @default(uuid()) @db.Uuid
  employeeId    String                @map("employee_id") @db.Uuid
  grossSalary   Decimal               @map("gross_salary") @db.Decimal(12, 2)
  netSalary     Decimal               @default(0) @map("net_salary") @db.Decimal(12, 2)
  effectiveFrom DateTime              @map("effective_from") @db.Date
  effectiveTo   DateTime?             @map("effective_to") @db.Date
  isActive      Boolean               @default(true) @map("is_active")
  createdAt     DateTime              @default(now()) @map("created_at")
  employee      Employee              @relation(fields: [employeeId], references: [id])
  items         SalaryStructureItem[]

  @@map("salary_structures")
}

model SalaryStructureItem {
  id                String          @id @default(uuid()) @db.Uuid
  salaryStructureId String          @map("salary_structure_id") @db.Uuid
  salaryComponentId String          @map("salary_component_id") @db.Uuid
  amount            Decimal         @db.Decimal(12, 2)
  
  structure         SalaryStructure @relation(fields: [salaryStructureId], references: [id], onDelete: Cascade)
  component         SalaryComponent @relation(fields: [salaryComponentId], references: [id])

  @@unique([salaryStructureId, salaryComponentId])
  @@map("salary_structure_items")
}


model AttendanceLog {
  id             String              @id @default(uuid()) @db.Uuid
  employeeId     String              @map("employee_id") @db.Uuid
  attendanceDate DateTime            @map("attendance_date") @db.Date
  shiftId        String?             @map("shift_id") @db.Uuid
  workLocationId String?             @map("work_location_id") @db.Uuid
  checkIn        DateTime?           @map("check_in") @db.Timestamp(6)
  checkOut       DateTime?           @map("check_out") @db.Timestamp(6)
  totalHours     Decimal?            @map("total_hours") @db.Decimal(5, 2)
  status         String
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  employee       Employee            @relation(fields: [employeeId], references: [id])
  shift          Shift?              @relation(fields: [shiftId], references: [id])
  workLocation   WorkLocation?       @relation(fields: [workLocationId], references: [id])
  requests       AttendanceRequest[]
  overtime       OvertimeRecord[]

  @@unique([employeeId, attendanceDate])
  @@map("attendance_logs")
}

model AttendanceRequest {
  id              String        @id @default(uuid()) @db.Uuid
  attendanceId    String        @map("attendance_id") @db.Uuid
  employeeId      String        @map("employee_id") @db.Uuid
  reason          String
  status          String        @default("pending")
  requestedAt     DateTime      @default(now()) @map("requested_at")
  approvedBy      String?       @map("approved_by") @db.Uuid
  approvedAt      DateTime?     @map("approved_at")
  rejectionReason String?       @map("rejection_reason")
  createdAt       DateTime      @default(now()) @map("created_at")
  attendance      AttendanceLog @relation(fields: [attendanceId], references: [id])
  employee        Employee      @relation(fields: [employeeId], references: [id])

  @@map("attendance_requests")
}

model OvertimeRecord {
  id              String        @id @default(uuid()) @db.Uuid
  employeeId      String        @map("employee_id") @db.Uuid
  attendanceId    String        @map("attendance_id") @db.Uuid
  hours           Decimal       @db.Decimal(5, 2)
  status          String        @default("pending")
  approvedBy      String?       @map("approved_by") @db.Uuid
  approvedAt      DateTime?     @map("approved_at")
  rejectionReason String?       @map("rejection_reason")
  createdAt       DateTime      @default(now()) @map("created_at")
  attendance      AttendanceLog @relation(fields: [attendanceId], references: [id])
  employee        Employee      @relation(fields: [employeeId], references: [id])

  @@map("overtime_records")
}

model LeaveType {
  id            String         @id @default(uuid()) @db.Uuid
  companyId     String         @map("company_id") @db.Uuid
  name          String
  maxDays       Int            @map("max_days")
  isPaid        Boolean        @default(true) @map("is_paid")
  carryForward  Boolean        @default(false) @map("carry_forward")
  createdAt     DateTime       @default(now()) @map("created_at")
  leaveBalances LeaveBalance[]
  leaveRequests LeaveRequest[]
  company       Company        @relation(fields: [companyId], references: [id])

  @@map("leave_types")
}

model LeaveBalance {
  id             String    @id @default(uuid()) @db.Uuid
  employeeId     String    @map("employee_id") @db.Uuid
  leaveTypeId    String    @map("leave_type_id") @db.Uuid
  year           Int
  entitledDays   Decimal   @map("entitled_days") @db.Decimal(5, 2)
  balance        Decimal   @db.Decimal(5, 2)
  carriedForward Decimal   @default(0) @map("carried_forward") @db.Decimal(5, 2)
  updatedAt      DateTime  @updatedAt @map("updated_at")
  employee       Employee  @relation(fields: [employeeId], references: [id])
  leaveType      LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@unique([employeeId, leaveTypeId, year])
  @@map("leave_balances")
}

model LeaveRequest {
  id              String    @id @default(uuid()) @db.Uuid
  employeeId      String    @map("employee_id") @db.Uuid
  leaveTypeId     String    @map("leave_type_id") @db.Uuid
  startDate       DateTime  @map("start_date") @db.Date
  endDate         DateTime  @map("end_date") @db.Date
  totalDays       Decimal   @map("total_days") @db.Decimal(5, 2)
  reason          String?
  status          String    @default("pending")
  approvedBy      String?   @map("approved_by") @db.Uuid
  approvedAt      DateTime? @map("approved_at")
  rejectionReason String?   @map("rejection_reason")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  employee        Employee  @relation(fields: [employeeId], references: [id])
  leaveType       LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@map("leave_requests")
}

model Holiday {
  id             String        @id @default(uuid()) @db.Uuid
  companyId      String        @map("company_id") @db.Uuid
  workLocationId String?       @map("work_location_id") @db.Uuid
  clusterId      String?       @map("cluster_id") @db.Uuid
  date           DateTime      @db.Date
  name           String
  isOptional     Boolean       @default(false) @map("is_optional")
  createdAt      DateTime      @default(now()) @map("created_at")
  company        Company       @relation(fields: [companyId], references: [id])
  workLocation   WorkLocation? @relation(fields: [workLocationId], references: [id])
  cluster        Cluster?      @relation(fields: [clusterId], references: [id])

  @@unique([companyId, workLocationId, clusterId, date])
  @@map("holidays")
}

model PayrollCycle {
  id             String          @id @default(uuid()) @db.Uuid
  companyId      String          @map("company_id") @db.Uuid
  workLocationId String          @map("work_location_id") @db.Uuid
  month          DateTime        @db.Date
  status         String          @default("draft")
  triggeredBy    String?         @map("triggered_by") @db.Uuid
  finalizedAt    DateTime?       @map("finalized_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  company        Company         @relation(fields: [companyId], references: [id])
  workLocation   WorkLocation    @relation(fields: [workLocationId], references: [id])
  launcher       User?           @relation(fields: [triggeredBy], references: [id])
  payrollRecords PayrollRecord[]

  @@unique([companyId, workLocationId, month])
  @@map("payroll_cycles")
}

model PayrollRecord {
  id                  String       @id @default(uuid()) @db.Uuid
  payrollCycleId      String       @map("payroll_cycle_id") @db.Uuid
  employeeId          String       @map("employee_id") @db.Uuid
  basicSalary         Decimal      @map("basic_salary") @db.Decimal(12, 2)
  hra                 Decimal      @default(0) @db.Decimal(12, 2)
  transportAllowance  Decimal      @default(0) @map("transport_allowance") @db.Decimal(12, 2)
  otherAllowances     Decimal      @default(0) @map("other_allowances") @db.Decimal(12, 2)
  grossSalary         Decimal      @map("gross_salary") @db.Decimal(12, 2)
  attendanceDeduction Decimal      @default(0) @map("attendance_deduction") @db.Decimal(12, 2)
  leaveDeduction      Decimal      @default(0) @map("leave_deduction") @db.Decimal(12, 2)
  pfDeduction         Decimal      @default(0) @map("pf_deduction") @db.Decimal(12, 2)
  esiDeduction        Decimal      @default(0) @map("esi_deduction") @db.Decimal(12, 2)
  ptDeduction         Decimal      @default(0) @map("pt_deduction") @db.Decimal(12, 2)
  incomeTax           Decimal      @default(0) @map("income_tax") @db.Decimal(12, 2)
  otherDeductions     Decimal      @default(0) @map("other_deductions") @db.Decimal(12, 2)
  overtimePay         Decimal      @default(0) @map("overtime_pay") @db.Decimal(12, 2)
  netSalary           Decimal      @map("net_salary") @db.Decimal(12, 2)
  workingDays         Int          @map("working_days")
  presentDays         Int          @map("present_days")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")
  employee            Employee     @relation(fields: [employeeId], references: [id])
  payrollCycle        PayrollCycle @relation(fields: [payrollCycleId], references: [id])
  payslip             Payslip?

  @@unique([payrollCycleId, employeeId])
  @@map("payroll_records")
}

model Payslip {
  id              String        @id @default(uuid()) @db.Uuid
  payrollRecordId String        @unique @map("payroll_record_id") @db.Uuid
  pdfUrl          String        @map("pdf_url")
  fileSizeBytes   Int?          @map("file_size_bytes")
  generatedAt     DateTime      @default(now()) @map("generated_at")
  payrollRecord   PayrollRecord @relation(fields: [payrollRecordId], references: [id])

  @@map("payslips")
}

model Workflow {
  id        String         @id @default(uuid()) @db.Uuid
  companyId String         @map("company_id") @db.Uuid
  module    String
  isActive  Boolean        @default(true) @map("is_active")
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  steps     ApprovalStep[]
  company   Company        @relation(fields: [companyId], references: [id])

  @@unique([companyId, module])
  @@map("workflows")
}

model ApprovalStep {
  id         String   @id @default(uuid()) @db.Uuid
  workflowId String   @map("workflow_id") @db.Uuid
  stepOrder  Int      @map("step_order")
  roleId     String   @map("role_id") @db.Uuid
  role       Role     @relation(fields: [roleId], references: [id])
  workflow   Workflow @relation(fields: [workflowId], references: [id])

  @@unique([workflowId, stepOrder])
  @@map("approval_steps")
}

model ApprovalLog {
  id         String   @id @default(uuid()) @db.Uuid
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id") @db.Uuid
  action     String
  actedBy    String   @map("acted_by") @db.Uuid
  actedAt    DateTime @default(now()) @map("acted_at")
  comment    String?
  actor      User     @relation(fields: [actedBy], references: [id])

  @@map("approval_logs")
}

model Plan {
  id               String         @id @default(uuid()) @db.Uuid
  name             String
  pricePerEmployee Decimal        @map("price_per_employee") @db.Decimal(10, 2)
  features         Json           @default("{}")
  isActive         Boolean        @default(true) @map("is_active")
  createdAt        DateTime       @default(now()) @map("created_at")
  subscriptions    Subscription[]

  @@map("plans")
}

model Subscription {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  planId    String    @map("plan_id") @db.Uuid
  startDate DateTime  @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date
  status    String    @default("active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  invoices  Invoice[]
  company   Company   @relation(fields: [companyId], references: [id])
  plan      Plan      @relation(fields: [planId], references: [id])

  @@map("subscriptions")
}

model Invoice {
  id             String       @id @default(uuid()) @db.Uuid
  subscriptionId String       @map("subscription_id") @db.Uuid
  invoiceNumber  String       @unique @map("invoice_number")
  amount         Decimal      @db.Decimal(12, 2)
  currency       String       @default("USD")
  status         String       @default("draft")
  issuedAt       DateTime?    @map("issued_at")
  dueDate        DateTime     @map("due_date") @db.Date
  paidAt         DateTime?    @map("paid_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
  payments       Payment[]

  @@map("invoices")
}

model Payment {
  id             String    @id @default(uuid()) @db.Uuid
  invoiceId      String    @map("invoice_id") @db.Uuid
  amount         Decimal   @db.Decimal(12, 2)
  currency       String    @default("USD")
  gateway        String
  transactionRef String    @map("transaction_ref")
  status         String
  paidAt         DateTime? @map("paid_at")
  failureReason  String?   @map("failure_reason")
  createdAt      DateTime  @default(now()) @map("created_at")
  invoice        Invoice   @relation(fields: [invoiceId], references: [id])

  @@map("payments")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  action    String
  entity    String
  entityId  String   @map("entity_id") @db.Uuid
  oldValues Json?    @map("old_values")
  newValues Json?    @map("new_values")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  company   Company  @relation(fields: [companyId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model SystemSetting {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  category    String
  key         String
  value       Json
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  company     Company  @relation(fields: [companyId], references: [id])

  @@unique([companyId, key])
  @@map("system_settings")
}

model PayrollRule {
  id                      String    @id @default(uuid()) @db.Uuid
  companyId               String    @map("company_id") @db.Uuid
  workLocationId          String?       @map("work_location_id") @db.Uuid
  frequencyType           String    @map("frequency_type")
  processingMode          String    @map("processing_mode")
  payrollDateType         String    @map("payroll_date_type")
  payrollDate             Int?      @map("payroll_date")
  attendanceCutoffDate    Int?      @map("attendance_cutoff_date")
  salaryCalculationMethod String    @map("salary_calculation_method")
  includeWeekends         Boolean   @default(false) @map("include_weekends")
  includeHolidays         Boolean   @default(true) @map("include_holidays")
  autoProcessEnabled      Boolean   @default(false) @map("auto_process_enabled")
  isActive                Boolean   @default(true) @map("is_active")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])
  workLocation            WorkLocation? @relation(fields: [workLocationId], references: [id])

  @@unique([companyId, workLocationId])
  @@map("payroll_rules")
}

model PayrollRun {
  id             String    @id @default(uuid()) @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  payrollPeriod  String    @map("payroll_period")
  runType        String    @map("run_type")
  triggeredBy    String?   @map("triggered_by") @db.Uuid
  status         String
  employeeCount  Int       @default(0) @map("employee_count")
  totalAmount    Decimal   @default(0) @map("total_amount") @db.Decimal(12, 2)
  startedAt      DateTime? @map("started_at")
  completedAt    DateTime? @map("completed_at")
  errorMessage   String?   @map("error_message")

  company Company @relation(fields: [companyId], references: [id])
  user    User?   @relation(fields: [triggeredBy], references: [id])

  @@map("payroll_runs")
}

model CompensationCycle {
  id             String           @id @default(uuid()) @db.Uuid
  companyId      String           @map("company_id") @db.Uuid
  name           String
  status         String           @default("draft") // draft, pending_approval, approved, applied
  effectiveFrom  DateTime         @map("effective_from") @db.Date
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  
  company        Company          @relation(fields: [companyId], references: [id])
  revisions      SalaryRevision[]

  @@map("compensation_cycles")
}

model SalaryRevision {
  id                  String            @id @default(uuid()) @db.Uuid
  compensationCycleId String            @map("compensation_cycle_id") @db.Uuid
  employeeId          String            @map("employee_id") @db.Uuid
  currentGross        Decimal           @map("current_gross") @db.Decimal(12, 2)
  proposedGross       Decimal           @map("proposed_gross") @db.Decimal(12, 2)
  basicSalary         Decimal           @map("basic_salary") @db.Decimal(12, 2)
  hra                 Decimal           @default(0) @db.Decimal(12, 2)
  transportAllowance  Decimal           @default(0) @map("transport_allowance") @db.Decimal(12, 2)
  otherAllowances     Decimal           @default(0) @map("other_allowances") @db.Decimal(12, 2)
  status              String            @default("draft") // draft, approved, rejected
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  compensationCycle   CompensationCycle @relation(fields: [compensationCycleId], references: [id])
  employee            Employee          @relation(fields: [employeeId], references: [id])

  @@unique([compensationCycleId, employeeId])
  @@map("salary_revisions")
}

model SalaryComponent {
  id             String               @id @default(uuid()) @db.Uuid
  companyId      String               @map("company_id") @db.Uuid
  name           String
  code           String               // e.g. BASIC, HRA, PF
  type           String               // earning, deduction
  calcType       String               // fixed, pct_ctc, pct_gross, pct_basic, formula, manual, remaining
  calcValue      Decimal?             @db.Decimal(12, 2)
  formula        String?              // formula string if calcType = formula
  isTaxable      Boolean              @default(true) @map("is_taxable")
  pfApplicable   Boolean              @default(false) @map("pf_applicable")
  esiApplicable  Boolean              @default(false) @map("esi_applicable")
  isActive       Boolean              @default(true) @map("is_active")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  company        Company              @relation(fields: [companyId], references: [id])
  templateItems  SalaryTemplateItem[]
  structureItems SalaryStructureItem[]

  @@unique([companyId, code])
  @@map("salary_components")
}

model SalaryTemplate {
  id          String               @id @default(uuid()) @db.Uuid
  companyId   String               @map("company_id") @db.Uuid
  name        String
  description String?
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")
  company     Company              @relation(fields: [companyId], references: [id])
  items       SalaryTemplateItem[]
  employees   Employee[]

  @@map("salary_templates")
}

model SalaryTemplateItem {
  id                String          @id @default(uuid()) @db.Uuid
  salaryTemplateId  String          @map("salary_template_id") @db.Uuid
  salaryComponentId String          @map("salary_component_id") @db.Uuid
  calcType          String?         // Override component default calcType if needed
  calcValue         Decimal?        @db.Decimal(12, 2)
  calculationOrder  Int             @default(0) @map("calculation_order")
  
  template          SalaryTemplate  @relation(fields: [salaryTemplateId], references: [id])
  component         SalaryComponent @relation(fields: [salaryComponentId], references: [id])

  @@unique([salaryTemplateId, salaryComponentId])
  @@map("salary_template_items")
}

