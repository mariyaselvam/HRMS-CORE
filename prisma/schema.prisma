generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id            String         @id @default(uuid()) @db.Uuid
  name          String
  industryType  String         @map("industry_type")
  employeeLimit Int            @map("employee_limit")
  timezone      String         @default("UTC")
  status        String         @default("active")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  auditLogs     AuditLog[]
  departments   Department[]
  employees     Employee[]
  holidays      Holiday[]
  leaveTypes    LeaveType[]
  payrollCycles PayrollCycle[]
  roles         Role[]
  shifts        Shift[]
  subscriptions Subscription[]
  teams         Team[]
  users         User[]
  workLocations WorkLocation[]
  workflows     Workflow[]

  @@map("companies")
}

model User {
  id              String             @id @default(uuid()) @db.Uuid
  companyId       String             @map("company_id") @db.Uuid
  email           String
  passwordHash    String             @map("password_hash")
  roleId          String             @map("role_id") @db.Uuid
  fcmToken        String?            @map("fcm_token")
  isActive        Boolean            @default(true) @map("is_active")
  lastLoginAt     DateTime?          @map("last_login_at")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  actedLogs       ApprovalLog[]
  auditLogs       AuditLog[]
  uploadedDocs    EmployeeDocument[]
  employee        Employee?
  triggeredCycles PayrollCycle[]
  company         Company            @relation(fields: [companyId], references: [id])
  role            Role               @relation(fields: [roleId], references: [id])

  @@unique([companyId, email])
  @@map("users")
}

model Role {
  id            String           @id @default(uuid()) @db.Uuid
  companyId     String           @map("company_id") @db.Uuid
  name          String
  description   String?
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  approvalSteps ApprovalStep[]
  permissions   RolePermission[]
  company       Company          @relation(fields: [companyId], references: [id])
  users         User[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique
  description String?
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id])
  role         Role       @relation(fields: [roleId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Department {
  id        String     @id @default(uuid()) @db.Uuid
  companyId String     @map("company_id") @db.Uuid
  name      String
  managerId String?    @map("manager_id") @db.Uuid
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  company   Company    @relation(fields: [companyId], references: [id])
  manager   Employee?  @relation("DepartmentManager", fields: [managerId], references: [id])
  employees Employee[] @relation("EmployeeDepartment")
  teams     Team[]

  @@map("departments")
}

model Team {
  id           String     @id @default(uuid()) @db.Uuid
  companyId    String     @map("company_id") @db.Uuid
  departmentId String     @map("department_id") @db.Uuid
  name         String
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  employees    Employee[]
  company      Company    @relation(fields: [companyId], references: [id])
  department   Department @relation(fields: [departmentId], references: [id])

  @@map("teams")
}

model WorkLocation {
  id             String          @id @default(uuid()) @db.Uuid
  companyId      String          @map("company_id") @db.Uuid
  name           String
  address        String?
  geoRequired    Boolean         @default(false) @map("geo_required")
  latitude       Decimal?
  longitude      Decimal?
  radiusMeters   Int?            @map("radius_meters")
  createdAt      DateTime        @default(now()) @map("created_at")
  attendanceLogs AttendanceLog[]
  company        Company         @relation(fields: [companyId], references: [id])

  @@map("work_locations")
}

model Shift {
  id             String          @id @default(uuid()) @db.Uuid
  companyId      String          @map("company_id") @db.Uuid
  name           String
  startTime      DateTime        @map("start_time") @db.Time(6)
  endTime        DateTime        @map("end_time") @db.Time(6)
  graceMinutes   Int             @default(0) @map("grace_minutes")
  createdAt      DateTime        @default(now()) @map("created_at")
  attendanceLogs AttendanceLog[]
  employeeShifts EmployeeShift[]
  company        Company         @relation(fields: [companyId], references: [id])

  @@map("shifts")
}

model EmployeeShift {
  id            String    @id @default(uuid()) @db.Uuid
  employeeId    String    @map("employee_id") @db.Uuid
  shiftId       String    @map("shift_id") @db.Uuid
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  employee      Employee  @relation(fields: [employeeId], references: [id])
  shift         Shift     @relation(fields: [shiftId], references: [id])

  @@unique([employeeId, effectiveFrom])
  @@map("employee_shifts")
}

model Employee {
  id                String    @id @default(uuid()) @db.Uuid
  companyId         String    @map("company_id") @db.Uuid
  userId            String    @unique @map("user_id") @db.Uuid
  employeeCode      String    @map("employee_code")
  departmentId      String    @map("department_id") @db.Uuid
  teamId            String?   @map("team_id") @db.Uuid
  managerId         String?   @map("manager_id") @db.Uuid
  dateOfJoining     DateTime  @map("date_of_joining") @db.Date
  employmentStatus  String    @default("active") @map("employment_status")
  dateOfLeaving     DateTime? @map("date_of_leaving") @db.Date
  onboardingStep    Int       @default(1) @map("onboarding_step")
  profileCompletion Int       @default(0) @map("profile_completion")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  // Modular Details
  personalDetails  EmployeePersonalDetail?
  jobDetails       EmployeeJobDetail?
  bankDetails      EmployeeBankDetail?
  statutoryDetails EmployeeStatutoryDetail?

  attendanceLogs   AttendanceLog[]
  attendanceReqs   AttendanceRequest[]
  managedDepts     Department[]        @relation("DepartmentManager")
  documents        EmployeeDocument[]
  shifts           EmployeeShift[]
  company          Company             @relation(fields: [companyId], references: [id])
  department       Department          @relation("EmployeeDepartment", fields: [departmentId], references: [id])
  manager          Employee?           @relation("EmployeeManager", fields: [managerId], references: [id])
  subordinates     Employee[]          @relation("EmployeeManager")
  team             Team?               @relation(fields: [teamId], references: [id])
  user             User                @relation(fields: [userId], references: [id])
  leaveBalances    LeaveBalance[]
  leaveRequests    LeaveRequest[]
  overtimeRecords  OvertimeRecord[]
  payrollRecords   PayrollRecord[]
  salaryStructures SalaryStructure[]

  @@unique([companyId, employeeCode])
  @@map("employees")
}

model EmployeePersonalDetail {
  id             String    @id @default(uuid()) @db.Uuid
  employeeId     String    @unique @map("employee_id") @db.Uuid
  firstName      String    @map("first_name")
  lastName       String    @map("last_name")
  mobile         String?
  gender         String?
  dob            DateTime? @db.Date
  maritalStatus  String?   @map("marital_status")
  currentAddress String?   @map("current_address")
  permAddress    String?   @map("perm_address")
  employee       Employee  @relation(fields: [employeeId], references: [id])

  @@map("employee_personal_details")
}

model EmployeeJobDetail {
  id               String    @id @default(uuid()) @db.Uuid
  employeeId       String    @unique @map("employee_id") @db.Uuid
  designation      String?
  employmentType   String?   @map("employment_type") // Full-time, Contract, Intern
  workLocationType String?   @map("work_location_type") // Office, Remote, Hybrid
  probationPeriod  Int?      @map("probation_period") // in months
  confirmationDate DateTime? @map("confirmation_date") @db.Date
  noticePeriod     Int?      @map("notice_period") // in days
  employee         Employee  @relation(fields: [employeeId], references: [id])

  @@map("employee_job_details")
}

model EmployeeBankDetail {
  id            String   @id @default(uuid()) @db.Uuid
  employeeId    String   @unique @map("employee_id") @db.Uuid
  accountNumber String?  @map("account_number")
  ifscCode      String?  @map("ifsc_code")
  bankName      String?  @map("bank_name")
  branchName    String?  @map("branch_name")
  employee      Employee @relation(fields: [employeeId], references: [id])

  @@map("employee_bank_details")
}

model EmployeeStatutoryDetail {
  id            String   @id @default(uuid()) @db.Uuid
  employeeId    String   @unique @map("employee_id") @db.Uuid
  pan           String?  @unique
  uan           String?  @unique // Universal Account Number (PF)
  pfApplicable  Boolean  @default(false) @map("pf_applicable")
  esiNumber     String?  @unique @map("esi_number")
  esiApplicable Boolean  @default(false) @map("esi_applicable")
  ptState       String?  @map("pt_state") // Professional Tax state
  taxRegime     String?  @default("new") @map("tax_regime") // old or new
  employee      Employee @relation(fields: [employeeId], references: [id])

  @@map("employee_statutory_details")
}

model EmployeeDocument {
  id           String    @id @default(uuid()) @db.Uuid
  employeeId   String    @map("employee_id") @db.Uuid
  documentType String    @map("document_type")
  fileUrl      String    @map("file_url")
  fileName     String?   @map("file_name")
  expiryDate   DateTime? @map("expiry_date") @db.Date
  uploadedBy   String    @map("uploaded_by") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")
  employee     Employee  @relation(fields: [employeeId], references: [id])
  uploader     User      @relation(fields: [uploadedBy], references: [id])

  @@map("employee_documents")
}

model SalaryStructure {
  id                 String  @id @default(uuid()) @db.Uuid
  employeeId         String  @map("employee_id") @db.Uuid
  basicSalary        Decimal @map("basic_salary")
  hra                Decimal @default(0)
  transportAllowance Decimal @default(0) @map("transport_allowance")
  otherAllowances    Decimal @default(0) @map("other_allowances")
  grossSalary        Decimal @map("gross_salary")

  // Statutory Components
  pfContribution  Decimal @default(0) @map("pf_contribution")
  esiContribution Decimal @default(0) @map("esi_contribution")

  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  employee      Employee  @relation(fields: [employeeId], references: [id])

  @@map("salary_structures")
}

model AttendanceLog {
  id             String              @id @default(uuid()) @db.Uuid
  employeeId     String              @map("employee_id") @db.Uuid
  attendanceDate DateTime            @map("attendance_date") @db.Date
  shiftId        String?             @map("shift_id") @db.Uuid
  workLocationId String?             @map("work_location_id") @db.Uuid
  checkIn        DateTime?           @map("check_in") @db.Timestamp(6)
  checkOut       DateTime?           @map("check_out") @db.Timestamp(6)
  totalHours     Decimal?            @map("total_hours")
  status         String
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  employee       Employee            @relation(fields: [employeeId], references: [id])
  shift          Shift?              @relation(fields: [shiftId], references: [id])
  workLocation   WorkLocation?       @relation(fields: [workLocationId], references: [id])
  requests       AttendanceRequest[]
  overtime       OvertimeRecord[]

  @@unique([employeeId, attendanceDate])
  @@map("attendance_logs")
}

model AttendanceRequest {
  id              String        @id @default(uuid()) @db.Uuid
  attendanceId    String        @map("attendance_id") @db.Uuid
  employeeId      String        @map("employee_id") @db.Uuid
  reason          String
  status          String        @default("pending")
  requestedAt     DateTime      @default(now()) @map("requested_at")
  approvedBy      String?       @map("approved_by") @db.Uuid
  approvedAt      DateTime?     @map("approved_at")
  rejectionReason String?       @map("rejection_reason")
  createdAt       DateTime      @default(now()) @map("created_at")
  attendance      AttendanceLog @relation(fields: [attendanceId], references: [id])
  employee        Employee      @relation(fields: [employeeId], references: [id])

  @@map("attendance_requests")
}

model OvertimeRecord {
  id              String        @id @default(uuid()) @db.Uuid
  employeeId      String        @map("employee_id") @db.Uuid
  attendanceId    String        @map("attendance_id") @db.Uuid
  hours           Decimal
  status          String        @default("pending")
  approvedBy      String?       @map("approved_by") @db.Uuid
  approvedAt      DateTime?     @map("approved_at")
  rejectionReason String?       @map("rejection_reason")
  createdAt       DateTime      @default(now()) @map("created_at")
  attendance      AttendanceLog @relation(fields: [attendanceId], references: [id])
  employee        Employee      @relation(fields: [employeeId], references: [id])

  @@map("overtime_records")
}

model LeaveType {
  id            String         @id @default(uuid()) @db.Uuid
  companyId     String         @map("company_id") @db.Uuid
  name          String
  maxDays       Int            @map("max_days")
  isPaid        Boolean        @default(true) @map("is_paid")
  carryForward  Boolean        @default(false) @map("carry_forward")
  createdAt     DateTime       @default(now()) @map("created_at")
  leaveBalances LeaveBalance[]
  leaveRequests LeaveRequest[]
  company       Company        @relation(fields: [companyId], references: [id])

  @@map("leave_types")
}

model LeaveBalance {
  id             String    @id @default(uuid()) @db.Uuid
  employeeId     String    @map("employee_id") @db.Uuid
  leaveTypeId    String    @map("leave_type_id") @db.Uuid
  year           Int
  entitledDays   Decimal   @map("entitled_days")
  balance        Decimal
  carriedForward Decimal   @default(0) @map("carried_forward")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  employee       Employee  @relation(fields: [employeeId], references: [id])
  leaveType      LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@unique([employeeId, leaveTypeId, year])
  @@map("leave_balances")
}

model LeaveRequest {
  id              String    @id @default(uuid()) @db.Uuid
  employeeId      String    @map("employee_id") @db.Uuid
  leaveTypeId     String    @map("leave_type_id") @db.Uuid
  startDate       DateTime  @map("start_date") @db.Date
  endDate         DateTime  @map("end_date") @db.Date
  totalDays       Decimal   @map("total_days")
  reason          String?
  status          String    @default("pending")
  approvedBy      String?   @map("approved_by") @db.Uuid
  approvedAt      DateTime? @map("approved_at")
  rejectionReason String?   @map("rejection_reason")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  employee        Employee  @relation(fields: [employeeId], references: [id])
  leaveType       LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@map("leave_requests")
}

model Holiday {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  date       DateTime @db.Date
  name       String
  isOptional Boolean  @default(false) @map("is_optional")
  createdAt  DateTime @default(now()) @map("created_at")
  company    Company  @relation(fields: [companyId], references: [id])

  @@unique([companyId, date])
  @@map("holidays")
}

model PayrollCycle {
  id             String          @id @default(uuid()) @db.Uuid
  companyId      String          @map("company_id") @db.Uuid
  month          DateTime        @db.Date
  status         String          @default("draft")
  triggeredBy    String?         @map("triggered_by") @db.Uuid
  finalizedAt    DateTime?       @map("finalized_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  company        Company         @relation(fields: [companyId], references: [id])
  launcher       User?           @relation(fields: [triggeredBy], references: [id])
  payrollRecords PayrollRecord[]

  @@unique([companyId, month])
  @@map("payroll_cycles")
}

model PayrollRecord {
  id                 String  @id @default(uuid()) @db.Uuid
  payrollCycleId     String  @map("payroll_cycle_id") @db.Uuid
  employeeId         String  @map("employee_id") @db.Uuid
  basicSalary        Decimal @map("basic_salary")
  hra                Decimal @default(0)
  transportAllowance Decimal @default(0) @map("transport_allowance")
  otherAllowances    Decimal @default(0) @map("other_allowances")
  grossSalary        Decimal @map("gross_salary")

  // Deductions
  attendanceDeduction Decimal @default(0) @map("attendance_deduction")
  leaveDeduction      Decimal @default(0) @map("leave_deduction")

  // Statutory Deductions
  pfDeduction  Decimal @default(0) @map("pf_deduction")
  esiDeduction Decimal @default(0) @map("esi_deduction")
  ptDeduction  Decimal @default(0) @map("pt_deduction")
  incomeTax    Decimal @default(0) @map("income_tax")

  otherDeductions Decimal      @default(0) @map("other_deductions")
  overtimePay     Decimal      @default(0) @map("overtime_pay")
  netSalary       Decimal      @map("net_salary")
  workingDays     Int          @map("working_days")
  presentDays     Int          @map("present_days")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  employee        Employee     @relation(fields: [employeeId], references: [id])
  payrollCycle    PayrollCycle @relation(fields: [payrollCycleId], references: [id])
  payslip         Payslip?

  @@unique([payrollCycleId, employeeId])
  @@map("payroll_records")
}

model Payslip {
  id              String        @id @default(uuid()) @db.Uuid
  payrollRecordId String        @unique @map("payroll_record_id") @db.Uuid
  pdfUrl          String        @map("pdf_url")
  fileSizeBytes   Int?          @map("file_size_bytes")
  generatedAt     DateTime      @default(now()) @map("generated_at")
  payrollRecord   PayrollRecord @relation(fields: [payrollRecordId], references: [id])

  @@map("payslips")
}

model Workflow {
  id        String         @id @default(uuid()) @db.Uuid
  companyId String         @map("company_id") @db.Uuid
  module    String
  isActive  Boolean        @default(true) @map("is_active")
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  steps     ApprovalStep[]
  company   Company        @relation(fields: [companyId], references: [id])

  @@unique([companyId, module])
  @@map("workflows")
}

model ApprovalStep {
  id         String   @id @default(uuid()) @db.Uuid
  workflowId String   @map("workflow_id") @db.Uuid
  stepOrder  Int      @map("step_order")
  roleId     String   @map("role_id") @db.Uuid
  role       Role     @relation(fields: [roleId], references: [id])
  workflow   Workflow @relation(fields: [workflowId], references: [id])

  @@unique([workflowId, stepOrder])
  @@map("approval_steps")
}

model ApprovalLog {
  id         String   @id @default(uuid()) @db.Uuid
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id") @db.Uuid
  action     String
  actedBy    String   @map("acted_by") @db.Uuid
  actedAt    DateTime @default(now()) @map("acted_at")
  comment    String?
  actor      User     @relation(fields: [actedBy], references: [id])

  @@map("approval_logs")
}

model Plan {
  id               String         @id @default(uuid()) @db.Uuid
  name             String
  pricePerEmployee Decimal        @map("price_per_employee")
  features         Json           @default("{}")
  isActive         Boolean        @default(true) @map("is_active")
  createdAt        DateTime       @default(now()) @map("created_at")
  subscriptions    Subscription[]

  @@map("plans")
}

model Subscription {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  planId    String    @map("plan_id") @db.Uuid
  startDate DateTime  @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date
  status    String    @default("active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  invoices  Invoice[]
  company   Company   @relation(fields: [companyId], references: [id])
  plan      Plan      @relation(fields: [planId], references: [id])

  @@map("subscriptions")
}

model Invoice {
  id             String       @id @default(uuid()) @db.Uuid
  subscriptionId String       @map("subscription_id") @db.Uuid
  invoiceNumber  String       @unique @map("invoice_number")
  amount         Decimal
  currency       String       @default("USD")
  status         String       @default("draft")
  issuedAt       DateTime?    @map("issued_at")
  dueDate        DateTime     @map("due_date") @db.Date
  paidAt         DateTime?    @map("paid_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
  payments       Payment[]

  @@map("invoices")
}

model Payment {
  id             String    @id @default(uuid()) @db.Uuid
  invoiceId      String    @map("invoice_id") @db.Uuid
  amount         Decimal
  currency       String    @default("USD")
  gateway        String
  transactionRef String    @map("transaction_ref")
  status         String
  paidAt         DateTime? @map("paid_at")
  failureReason  String?   @map("failure_reason")
  createdAt      DateTime  @default(now()) @map("created_at")
  invoice        Invoice   @relation(fields: [invoiceId], references: [id])

  @@map("payments")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  action    String
  entity    String
  entityId  String   @map("entity_id") @db.Uuid
  oldValues Json?    @map("old_values")
  newValues Json?    @map("new_values")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  company   Company  @relation(fields: [companyId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}
