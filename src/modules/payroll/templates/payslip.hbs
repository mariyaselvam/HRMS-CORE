<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>Payslip - {{month}} {{year}}</title>
    <style>
        body { font-family: 'Helvetica', 'Arial', sans-serif; color: #333; margin: 0; padding: 20px; font-size: 12px; }
        .header { display: flex; justify-content: space-between; margin-bottom: 30px; border-bottom: 2px solid #4a90e2; padding-bottom: 10px; }
        .company-info h1 { margin: 0; color: #4a90e2; font-size: 24px; }
        .payslip-details { margin-bottom: 30px; }
        .payslip-details table { width: 100%; border-collapse: collapse; }
        .payslip-details td { padding: 5px; }
        .section-title { background: #f4f7f6; padding: 10px; font-weight: bold; border-left: 4px solid #4a90e2; margin: 20px 0 10px 0; }
        .calculation-table { width: 100%; border-collapse: collapse; margin-bottom: 20px; }
        .calculation-table th { text-align: left; background: #fafafa; border-bottom: 1px solid #ddd; padding: 10px; }
        .calculation-table td { padding: 10px; border-bottom: 1px solid #eee; }
        .calculation-grid { display: flex; gap: 40px; }
        .earnings, .deductions { flex: 1; }
        .total-row { background: #fdfdfd; font-weight: bold; }
        .net-salary-box { border: 2px solid #4a90e2; background: #eef5fb; padding: 20px; text-align: center; margin-top: 30px; }
        .net-salary-box h2 { margin: 0; color: #4a90e2; }
        .footer { margin-top: 50px; font-size: 10px; color: #888; text-align: center; border-top: 1px solid #eee; padding-top: 10px; }
    </style>
</head>
<body>
    <div class="header">
        <div class="company-info">
            <h1>{{companyName}}</h1>
            <p>{{companyAddress}}</p>
        </div>
        <div class="payslip-title" style="text-align: right;">
            <h2 style="margin: 0;">PAYSLIP</h2>
            <p>For the month of: <strong>{{month}} {{year}}</strong></p>
        </div>
    </div>

    <div class="payslip-details">
        <table>
            <tr>
                <td><strong>Employee Name:</strong></td>
                <td>{{employeeName}}</td>
                <td><strong>Employee ID:</strong></td>
                <td>{{employeeCode}}</td>
            </tr>
            <tr>
                <td><strong>Designation:</strong></td>
                <td>{{designation}}</td>
                <td><strong>Department:</strong></td>
                <td>{{departmentName}}</td>
            </tr>
            <tr>
                <td><strong>Bank:</strong></td>
                <td>{{bankName}}</td>
                <td><strong>Account Number:</strong></td>
                <td>{{accountNumber}}</td>
            </tr>
            <tr>
                <td><strong>Working Days:</strong></td>
                <td>{{workingDays}}</td>
                <td><strong>Days Present:</strong></td>
                <td>{{presentDays}}</td>
            </tr>
        </table>
    </div>

    <div class="calculation-grid">
        <div class="earnings">
            <div class="section-title">EARNINGS</div>
            <table class="calculation-table">
                <tr><td>Basic Salary</td><td style="text-align: right;">{{basicSalary}}</td></tr>
                <tr><td>HRA</td><td style="text-align: right;">{{hra}}</td></tr>
                <tr><td>Transport Allowance</td><td style="text-align: right;">{{transportAllowance}}</td></tr>
                <tr><td>Other Allowances</td><td style="text-align: right;">{{otherAllowances}}</td></tr>
                <tr class="total-row"><td>Gross Earnings</td><td style="text-align: right;">{{grossSalary}}</td></tr>
            </table>
        </div>
        <div class="deductions">
            <div class="section-title">DEDUCTIONS</div>
            <table class="calculation-table">
                <tr><td>Attendance Deduction (LOP)</td><td style="text-align: right;">{{attendanceDeduction}}</td></tr>
                <tr><td>EPF</td><td style="text-align: right;">{{pfDeduction}}</td></tr>
                <tr><td>ESI</td><td style="text-align: right;">{{esiDeduction}}</td></tr>
                <tr><td>Professional Tax</td><td style="text-align: right;">{{ptDeduction}}</td></tr>
                <tr><td>Income Tax / Other</td><td style="text-align: right;">{{incomeTax}}</td></tr>
                <tr class="total-row"><td>Total Deductions</td><td style="text-align: right;">{{totalDeductions}}</td></tr>
            </table>
        </div>
    </div>

    <div class="net-salary-box">
        <p style="margin: 0 0 5px 0;">NET SALARY PAYABLE</p>
        <h2>{{currency}} {{netSalary}}</h2>
        <p style="font-size: 10px; margin-top: 5px;">({{netSalaryInWords}})</p>
    </div>

    <div class="footer">
        <p>This is a computer-generated document and does not require a physical signature.</p>
        <p>&copy; {{year}} {{companyName}} - HRMS System</p>
    </div>
</body>
</html>
